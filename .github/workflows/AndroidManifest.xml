          # Create Android manifest with Google AdMob support.
          android_ns = "http://schemas.android.com/apk/res/android"
          ET.register_namespace("android", android_ns)

          manifest = ET.Element("manifest")
          manifest.set("package", package_name)

          # Required permissions
          for permission_name in [
              "android.permission.INTERNET",
              "android.permission.ACCESS_NETWORK_STATE"
          ]:
              permission = ET.SubElement(manifest, "uses-permission")
              permission.set(
                  f"{{{android_ns}}}name",
                  permission_name
              )

          application = ET.SubElement(manifest, "application")
          application.set(f"{{{android_ns}}}label", app_name)
          application.set(
              f"{{{android_ns}}}theme",
              "@android:style/Theme.Material.Light.NoActionBar"
          )
          application.set(
              f"{{{android_ns}}}usesCleartextTraffic",
              "true"
          )

          # AdMob App ID from GitHub Secret
          admob_app_id = os.environ.get("ADMOB_APP_ID", "").strip()

          if admob_app_id:
              admob_meta = ET.SubElement(application, "meta-data")
              admob_meta.set(
                  f"{{{android_ns}}}name",
                  "com.google.android.gms.ads.APPLICATION_ID"
              )
              admob_meta.set(
                  f"{{{android_ns}}}value",
                  admob_app_id
              )
          else:
              print("WARNING: ADMOB_APP_ID secret not configured.")

          # Main Activity
          activity = ET.SubElement(application, "activity")
          activity.set(
              f"{{{android_ns}}}name",
              ".MainActivity"
          )
          activity.set(
              f"{{{android_ns}}}exported",
              "true"
          )
          activity.set(
              f"{{{android_ns}}}configChanges",
              "keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
          )

          intent = ET.SubElement(activity, "intent-filter")

          action = ET.SubElement(intent, "action")
          action.set(
              f"{{{android_ns}}}name",
              "android.intent.action.MAIN"
          )

          category = ET.SubElement(intent, "category")
          category.set(
              f"{{{android_ns}}}name",
              "android.intent.category.LAUNCHER"
          )

          manifest_path = root / "app/src/main/AndroidManifest.xml"
          manifest_path.parent.mkdir(parents=True, exist_ok=True)

          ET.ElementTree(manifest).write(
              manifest_path,
              encoding="utf-8",
              xml_declaration=True
          )